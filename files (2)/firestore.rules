rules_version = '2';

// ============================================================
// FIRESTORE SECURITY RULES
//
// This app runs entirely on the free Spark plan — there is no Cloud
// Storage bucket and no storage.rules file. Every file (photo, signature,
// proof) is compressed client-side and stored as a Base64 string inside
// the `values` map of the submission document itself.
//
// Firestore caps each document at 1MiB total, so keep each field's
// "Max file size (KB)" small in the Form Builder (the app already
// warns you, and does a client-side size check before writing).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.uid == "5R2061iDtwUIfXp1aacA378fhza2";
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Form templates: any signed-in user can read (needed to render the
    // dynamic form), but only the Admin can create/edit/delete them.
    match /form_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // App-wide settings (e.g. which template is currently active).
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Submissions: a customer can only read/create/update their OWN
    // submission document (its ID is their own uid). The Admin can
    // read and update (e.g. approve/reject) every submission.
    // `values` holds both plain text answers AND Base64 image strings
    // for document fields, all in one ordered map keyed by field id.
    match /user_submissions/{ownerUid} {
      // Note: Firestore rules can't directly measure a document's total
      // serialized byte size, so the 1MiB ceiling is enforced client-side
      // (see the check in handleSubmitForm() in index.html) rather than here.
      allow read: if isOwner(ownerUid) || isAdmin();
      allow create: if isOwner(ownerUid);
      // Customers may keep editing their own submission's answers/files,
      // but only the Admin may flip `status` between pending/approved/rejected.
      allow update: if isAdmin() ||
        (isOwner(ownerUid) &&
         request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }
  }
}
