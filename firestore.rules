rules_version = '2';

// ============================================================
// FIRESTORE SECURITY RULES — Sirisha Studio
//
// Free Spark plan only — no Cloud Storage. Every uploaded file (photo,
// signature, PDF) is compressed client-side and stored as a Base64 string
// inside the submission document itself. Keep each field's "Max size (KB)"
// modest in the Form Builder — Firestore caps a document at 1MiB total.
//
// Submission documents are keyed as "{uid}__{templateId}", so one user can
// have one submission per form/template.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        (request.auth.uid == "5R2061iDtwUIfXp1aacA378fhza2" ||
         request.auth.token.email == "sirishastudio9@gmail.com");
    }
    function ownerOf(subId) {
      return subId.split('__')[0];
    }
    function isOwner(subId) {
      return isSignedIn() && request.auth.uid == ownerOf(subId);
    }

    // Form templates: the Admin can read/write everything. Regular users
    // may only read templates that have been published — drafts stay
    // invisible even if someone guesses a template ID.
    match /form_templates/{templateId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow write: if isAdmin();
    }

    // Submissions: doc ID is "{ownerUid}__{templateId}".
    // - The owning customer can read/create their own submission, and can
    //   keep editing their own answers — but NOT their payment/application
    //   status or rejection reason (those are Admin-only fields).
    // - The Admin can read, update, and delete every submission.
    match /user_submissions/{subId} {
      allow read: if isOwner(subId) || isAdmin();
      allow create: if isOwner(subId) && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() ||
        (isOwner(subId) &&
         request.resource.data.paymentStatus == resource.data.paymentStatus &&
         request.resource.data.applicationStatus == resource.data.applicationStatus &&
         request.resource.data.rejectionReason == resource.data.rejectionReason);
      allow delete: if isAdmin();
    }
  }
}
